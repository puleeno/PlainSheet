import {
    Button,
    VerticalBox,
    HorizontalBox,
    LineEdit,
    ListView,
} from "std-widgets.slint";

component SelectableCell inherits Rectangle {
    in property <string> cell-text;
    in property <bool> is-selected;
    in property <bool> even;

    background: is-selected ? #c7d2fe : even ? #f8fafc : #ffffff;
    border-color: #e2e8f0;
    border-width: 1px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;

        Text {
            text: cell-text;
            color: is-selected ? #312e81 : #1e293b;
            font-size: 13px;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

component SelectableTable inherits Rectangle {
    in property <[string]> columns;
    in property <[[string]]> rows;
    in-out property <int> selected-column: -1;
    in-out property <int> sorted-column: -1;
    in-out property <bool> sort-ascending: true;

    callback column-clicked(int);
    callback sort-clicked(int, bool);

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Header
        Rectangle {
            height: 40px;
            background: #f1f5f9;
            border-color: #cbd5e1;
            border-width: 2px;

            HorizontalLayout {
                for col-idx in root.columns.length : Rectangle {
                    horizontal-stretch: 1;
                    background: col-idx == root.selected-column ? #c7d2fe : touch-header.has-hover ? #e2e8f0 : transparent;
                    border-color: #e2e8f0;
                    border-width: 1px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        alignment: space-between;

                        Text {
                            text: col-idx < root.columns.length ? root.columns[col-idx] : "";
                            color: col-idx == root.selected-column ? #312e81 : #475569;
                            font-size: 12px;
                            font-weight: 800;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        // Sort icon
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            visible: col-idx == root.sorted-column;
                            Text {
                                text: root.sort-ascending ? "▲" : "▼";
                                color: #6366f1;
                                font-size: 10px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    touch-header := TouchArea {
                        clicked => {
                            root.column-clicked(col-idx);

                            // Toggle sort: ASC -> DESC -> unsorted
                            if (root.sorted-column == col-idx) {
                                if (root.sort-ascending) {
                                    root.sort-ascending = false;
                                } else {
                                    root.sorted-column = -1;
                                    root.sort-ascending = true;
                                }
                            } else {
                                root.sorted-column = col-idx;
                                root.sort-ascending = true;
                            }
                            root.sort-clicked(root.sorted-column, root.sort-ascending);
                        }
                    }
                }
            }
        }

        // Body
        ListView {
            vertical-stretch: 1;

            for row-idx in root.rows.length : VerticalLayout {
                padding: 0;
                spacing: 0;
                min-height: 36px;

                HorizontalLayout {
                    padding: 0;
                    spacing: 0;

                    for col-idx in (row-idx < root.rows.length ? root.rows[row-idx].length : 0) : SelectableCell {
                        cell-text: row-idx < root.rows.length && col-idx < root.rows[row-idx].length ? root.rows[row-idx][col-idx] : "";
                        is-selected: col-idx == root.selected-column;
                        even: mod(row-idx, 2) == 0;
                    }
                }
            }
        }
    }
}

component WindowButton inherits Rectangle {
    in property <string> btn-text;
    in property <color> hover-color: #334155;
    callback clicked();

    width: 36px;
    height: 32px;
    background: btn-touch.has-hover ? (btn-touch.pressed ? hover-color : hover-color) : transparent;
    border-radius: 4px;

    Text {
        text: btn-text;
        color: btn-touch.has-hover ? #ffffff : #94a3b8;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    btn-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "";
    min-width: 1200px;
    min-height: 850px;
    background: #ffffff;
    no-frame: true;

    callback open-file();
    callback save-file();
    callback run-extension(string);
    callback window-close();
    callback window-minimize();
    callback window-maximize();
    callback drag-window(length, length);
    callback sort-clicked(int, bool);

    in-out property <[[string]]> table-data: [];
    in-out property <[string]> table-header: ["A", "B", "C", "D"];
    in-out property <[StandardListViewItem]> extensions-list: [];
    in-out property <string> status-text: "System Ready";
    in-out property <int> row-count: 0;
    in-out property <bool> is-loading: false;
    in-out property <int> selected-column: -1;
    in-out property <int> sorted-column: -1;
    in-out property <bool> sort-ascending: true;

    // Drag state
    in-out property <length> last-mouse-x: 0;
    in-out property <length> last-mouse-y: 0;
    in-out property <bool> is-dragging: false;

    VerticalBox {
        padding: 0;
        spacing: 0;

        // CUSTOM TITLE BAR
        Rectangle {
            height: 44px;
            background: #0f172a;

            // Drag area - entire title bar
            drag-area := TouchArea {
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        root.is-dragging = true;
                        root.last-mouse-x = self.mouse-x;
                        root.last-mouse-y = self.mouse-y;
                    } else if (ev.kind == PointerEventKind.up) {
                        root.is-dragging = false;
                        root.last-mouse-x = 0;
                        root.last-mouse-y = 0;
                    }
                }
                moved => {
                    if (root.is-dragging) {
                        root.drag-window(self.mouse-x - root.last-mouse-x, self.mouse-y - root.last-mouse-y);
                        root.last-mouse-x = self.mouse-x;
                        root.last-mouse-y = self.mouse-y;
                    }
                }
            }

            HorizontalBox {
                padding-left: 16px;
                padding-right: 8px;
                spacing: 12px;
                alignment: center;

                // Logo & Title
                HorizontalBox {
                    spacing: 10px;
                    alignment: start;

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        background: #4f46e5;
                        border-radius: 6px;
                        Text {
                            text: "⊞";
                            color: white;
                            font-size: 16px;
                            font-weight: 900;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalBox {
                        alignment: center;
                        spacing: 0;
                        Text {
                            text: "PLAINSHEET PRO";
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 900;
                            letter-spacing: 1px;
                        }
                        Text {
                            text: "UNTITLED_DATA.CSV";
                            color: #94a3b8;
                            font-size: 9px;
                            font-weight: 700;
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                // Search Box
                Rectangle {
                    width: 420px;
                    height: 30px;
                    background: #1e293b;
                    border-radius: 6px;
                    HorizontalBox {
                        padding-left: 12px;
                        alignment: center;
                        Text { text: "🔍"; font-size: 11px; opacity: 0.4; }
                        LineEdit { placeholder-text: "Instant grid search..."; font-size: 12px; }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                // Window Controls
                HorizontalBox {
                    spacing: 4px;
                    alignment: end;

                    Rectangle {
                        height: 30px;
                        background: #ffffff10;
                        border-radius: 6px;
                        HorizontalBox {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;
                            Text { text: "⌘K"; color: #ffffff60; font-size: 10px; font-weight: 800; vertical-alignment: center; }
                        }
                    }

                    Button {
                        text: "💾 SAVE";
                        clicked => { root.save-file(); }
                    }

                    Rectangle {
                        height: 30px;
                        background: #ffffff;
                        border-radius: 6px;
                        HorizontalBox {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;
                            Text { text: "📂 EXPORT"; color: #000000; font-size: 10px; font-weight: 900; vertical-alignment: center; }
                            Text { text: "▼"; color: #000000; font-size: 8px; vertical-alignment: center; }
                        }
                    }

                    // Separator
                    Rectangle { width: 1px; height: 20px; background: #334155; }

                    // Minimize
                    WindowButton {
                        btn-text: "−";
                        clicked => { root.window-minimize(); }
                    }

                    // Maximize
                    WindowButton {
                        btn-text: "□";
                        clicked => { root.window-maximize(); }
                    }

                    // Close
                    Rectangle {
                        width: 36px;
                        height: 32px;
                        background: close-touch.has-hover ? (close-touch.pressed ? #dc2626 : #ef4444) : transparent;
                        border-radius: 4px;

                        Text {
                            text: "×";
                            color: close-touch.has-hover ? #ffffff : #94a3b8;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        close-touch := TouchArea {
                            clicked => { root.window-close(); }
                        }
                    }
                }
            }
        }

        // 2. MENU BAR
        Rectangle {
            height: 32px;
            background: #000000;
            HorizontalBox {
                padding-left: 20px;
                alignment: start;
                spacing: 0px;

                Rectangle {
                    height: 32px;
                    background: touch-file.pressed ? #1e293b : touch-file.has-hover ? #0f172a : transparent;
                    border-radius: 4px;
                    HorizontalBox {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        Text { text: "FILE"; color: #94a3b8; font-size: 11px; font-weight: 800; vertical-alignment: center; letter-spacing: 1px; }
                        Text { text: "⌄"; color: #64748b; font-size: 9px; vertical-alignment: center; }
                    }
                    touch-file := TouchArea { clicked => { root.open-file(); } }
                }

                Rectangle {
                    height: 32px;
                    background: touch-edit.pressed ? #1e293b : touch-edit.has-hover ? #0f172a : transparent;
                    border-radius: 4px;
                    HorizontalBox {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        Text { text: "EDIT"; color: #94a3b8; font-size: 11px; font-weight: 800; vertical-alignment: center; letter-spacing: 1px; }
                        Text { text: "ㅟ"; color: #64748b; font-size: 9px; vertical-alignment: center; }
                    }
                    touch-edit := TouchArea { }
                }

                Rectangle {
                    height: 32px;
                    background: touch-data.pressed ? #1e293b : touch-data.has-hover ? #0f172a : transparent;
                    border-radius: 4px;
                    HorizontalBox {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        Text { text: "DATA"; color: #94a3b8; font-size: 11px; font-weight: 800; vertical-alignment: center; letter-spacing: 1px; }
                        Text { text: "ㅟ"; color: #64748b; font-size: 9px; vertical-alignment: center; }
                    }
                    touch-data := TouchArea { }
                }

                Rectangle {
                    height: 32px;
                    background: touch-tools.pressed ? #1e293b : touch-tools.has-hover ? #0f172a : transparent;
                    border-radius: 4px;
                    HorizontalBox {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        Text { text: "TOOLS"; color: #94a3b8; font-size: 11px; font-weight: 800; vertical-alignment: center; letter-spacing: 1px; }
                        Text { text: "ㅟ"; color: #64748b; font-size: 9px; vertical-alignment: center; }
                    }
                    touch-tools := TouchArea { }
                }

                Rectangle {
                    height: 32px;
                    background: touch-help.pressed ? #1e293b : touch-help.has-hover ? #0f172a : transparent;
                    border-radius: 4px;
                    HorizontalBox {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        Text { text: "HELP"; color: #94a3b8; font-size: 11px; font-weight: 800; vertical-alignment: center; letter-spacing: 1px; }
                        Text { text: "ㅟ"; color: #64748b; font-size: 9px; vertical-alignment: center; }
                    }
                    touch-help := TouchArea { }
                }
            }
        }

        // 3. TAB BAR
        Rectangle {
            height: 36px;
            background: #f1f5f9;
            HorizontalBox {
                padding-left: 15px;
                alignment: start;
                spacing: 4px;

                Rectangle {
                    height: 28px;
                    width: 180px;
                    background: #ffffff;
                    border-radius: 4px;
                    y: 4px;
                    Rectangle { height: 2px; background: #6366f1; y: 0px; width: parent.width; }
                    HorizontalBox {
                        padding-left: 12px;
                        spacing: 8px;
                        alignment: center;
                        Text { text: "🗒"; font-size: 12px; vertical-alignment: center; }
                        Text { text: "UNTITLED_DATA.CSV"; color: #000000; font-size: 10px; font-weight: 900; vertical-alignment: center; }
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: 4px;
                    Text { text: "+"; color: #94a3b8; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        // 4. MAIN GRID
        Rectangle {
            background: #ffffff;
            vertical-stretch: 1;
            horizontal-stretch: 1;

            SelectableTable {
                columns: root.table-header;
                rows: root.table-data;
                selected-column: root.selected-column;
                sorted-column: root.sorted-column;
                sort-ascending: root.sort-ascending;
                column-clicked(col) => {
                    root.selected-column = col;
                }
                sort-clicked(col, asc) => {
                    root.sorted-column = col;
                    root.sort-ascending = asc;
                    root.sort-clicked(col, asc);
                }
            }
        }

        // 5. FOOTER
        Rectangle {
            height: 28px;
            background: #000000;
            HorizontalBox {
                padding-left: 20px;
                padding-right: 20px;
                alignment: center;

                HorizontalBox {
                    spacing: 15px;
                    alignment: start;

                    HorizontalBox {
                        spacing: 8px;
                        alignment: center;
                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #6366f1; }
                        Text { text: root.selected-column >= 0 ? "COL " + (root.selected-column + 1) + " SELECTED" : "IDLE"; color: #ffffff; font-size: 9px; font-weight: 900; vertical-alignment: center; }
                    }

                    HorizontalBox {
                        spacing: 8px;
                        alignment: center;
                        Text { text: "📂"; font-size: 10px; vertical-alignment: center; }
                        Text { text: "UNTITLED_DATA.CSV"; color: #94a3b8; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                    }

                    Rectangle {
                        height: 18px;
                        background: #1e293b;
                        border-radius: 4px;
                        HorizontalBox {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: center;
                            Text { text: "✓ ENTERPRISE LICENSE"; color: #6366f1; font-size: 9px; font-weight: 900; vertical-alignment: center; }
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Text { text: "PLAINSHEET GRID ENGINE"; color: #334155; font-size: 9px; font-weight: 900; letter-spacing: 2px; }

                Rectangle { horizontal-stretch: 1; }

                HorizontalBox {
                    spacing: 20px;
                    alignment: end;
                    Text { text: "FORMAT: [ , ] / UTF-8 / HDR:ON"; color: #94a3b8; font-size: 9px; font-weight: 800; }
                    Text { text: "STATS: " + root.row-count + " ROWS  " + root.table-header.length + " COLS"; color: #94a3b8; font-size: 9px; font-weight: 800; }
                    Text { text: "PRO V2.5.0 [EN]"; color: #334155; font-size: 9px; font-weight: 800; }
                }
            }
        }
    }
}
