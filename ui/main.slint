        // 4. MAIN GRID
        Rectangle {
            background: #ffffff;
            vertical-stretch: 1;
            horizontal-stretch: 1;

            SelectableTable {
                columns: root.table-header;
                rows: root.table-data;
                selected-column: root.selected-column;
                column-clicked(col) => {
                    root.selected-column = col;
                }
            }
        }

        // 5. FOOTER
        Rectangle {
            height: 28px;
            background: #000000;
            HorizontalBox {
                padding-left: 20px;
                padding-right: 20px;
                alignment: center;

                HorizontalBox {
                    spacing: 15px;
                    alignment: start;

                    HorizontalBox {
                        spacing: 8px;
                        alignment: center;
                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #6366f1; }
                        Text { text: root.selected-column >= 0 ? "COL " + (root.selected-column + 1) + " SELECTED" : "IDLE"; color: #ffffff; font-size: 9px; font-weight: 900; vertical-alignment: center; }
                    }

                    HorizontalBox {
                        spacing: 8px;
                        alignment: center;
